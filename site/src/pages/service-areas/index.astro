---
import Layout from '../../layouts/ServiceLayout.astro';
import {serviceAreaByCity} from '../../lib/serviceAreas';
const regions=[
 {title:'San Francisco',county:'San Francisco County',cities:['San Francisco']},
 {title:'The Peninsula',county:'San Mateo County',cities:['San Mateo','San Carlos','Redwood City']},
 {title:'East Bay · Contra Costa',county:'Contra Costa County',cities:['Walnut Creek','San Ramon','Danville','Clayton']},
 {title:'East Bay · Alameda',county:'Alameda County',cities:['Oakland','Berkeley','Fremont','Hayward','Livermore']},
 {title:'South Bay',county:'Santa Clara County',cities:['San Jose','Palo Alto','Mountain View']}
];
const services=[{title:'Gas tank water heaters',url:'/services/gas-tank-water-heaters/',copy:'Installation and replacement, with the full setup assessed.'},{title:'Tankless water heaters',url:'/services/tankless-water-heaters/',copy:'First-time conversions and replacement tankless systems.'},{title:'Heat pump water heaters',url:'/services/heat-pump-water-heaters/',copy:'Explore the space, power, and installation your home needs.'},{title:'Plumbing services',url:'/services/plumbing/',copy:'Fixtures, drains, repiping, bathroom updates, and more.'}];
---
<Layout title="Bay Area Water Heater & Plumbing Service Areas" description="Water Heater Boys serves San Francisco, the Peninsula, East Bay, and South Bay through San Jose." workHref="/#work" estimateIntro="Tell us your city and the service you need. Our team will discuss the work and scheduling with you.">
<section class="hero service-hero"><div class="wrap"><p class="breadcrumb"><a href="/">Home</a> / Service areas</p><div class="hero-grid"><div><p class="eyebrow">PROUD TO WORK WHERE YOU LIVE</p><h1>Across the Bay.<br/><em>Around the corner.</em></h1><p class="hero-description">Water heater and plumbing help across San Francisco, the Peninsula, the East Bay, and the South Bay—all the way down to San Jose.</p><div class="actions"><a class="button" href="#estimate">Request service ↗</a><a class="text-link" href="tel:6508442305">Call (650) 844-2305 ↗</a></div></div><aside class="service-summary"><p class="eyebrow">OUR BAY AREA SERVICE REGION</p><h2>Your address.<br/>Your project.<br/>A clear next step.</h2><p>The cities below are examples, not boundaries within our service region. We cover communities from San Francisco through San Jose and across the East Bay.</p><a class="text-link" href="#coverage">Explore our service area ↓</a></aside></div></div></section>
<section class="section wrap" id="coverage"><div class="section-heading"><div><p class="eyebrow">OUR SERVICE AREA</p><h2>Local help,<br/>across the Bay Area.</h2></div><p>The communities below are examples, not limits.<br/>Linked cities include completed local work.</p></div><div class="included-grid coverage-grid">{regions.map(r=><article class="included-card"><p class="eyebrow">{r.county}</p><h3>{r.title}</h3><ul>{r.cities.map(city=>{const area=serviceAreaByCity.get(city);return <li>{area?<a href={`/service-areas/${area.slug}/`}>{city} ↗</a>:city}</li>})}</ul></article>)}</div><p class="brand-note"><strong>Need service in San Francisco, the Peninsula, East Bay, or South Bay?</strong> Call <a href="tel:6508442305">(650) 844-2305</a> or send a service request. We’ll discuss the work and scheduling with you.</p></section>
<section class="section included-section"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">WHAT CAN WE HELP WITH?</p><h2>Find the right service.</h2></div></div><div class="services">{services.map(s=><a class="service" href={s.url}><h3>{s.title}</h3><p>{s.copy}</p><span class="service-link">Explore service ↗</span></a>)}</div></div></section>
</Layout>
