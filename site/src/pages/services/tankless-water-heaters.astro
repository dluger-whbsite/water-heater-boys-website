---
import ServicePage from '../../components/ServicePage.astro';
import {loadJobs} from '../../lib/jobs';
import {serviceJobs} from '../../lib/feeds.mjs';
const jobs=serviceJobs(await loadJobs(),'tankless');
const steps=[
 {title:'Plan the whole setup.',copy:'We evaluate gas capacity, venting, condensate drainage, available space, water quality, and household demand.'},
 {title:'Complete the installation.',copy:'We handle the necessary connections and installation work for the selected system and the existing setup.'},
 {title:'Test before we finish.',copy:'We test ignition, temperature stability, and safe operation before the job is complete.'}
];
const faqs=[
 {q:'Can you replace my tank water heater with tankless?',a:'We handle first-time tankless conversions as well as replacements of existing tankless units. We start by evaluating your home’s gas supply, venting, drainage, installation space, and hot water demand.'},
 {q:'Will my gas line or venting need changes?',a:'That depends on your existing setup and the selected unit. We evaluate gas line capacity and vent routing first, and address required upgrades as part of the installation plan.'},
 {q:'Do you replace existing tankless water heaters?',a:'Yes. Our team installs replacement gas tankless systems and evaluates the existing connections, venting, and drainage before the work.'},
 {q:'How do I get an estimate?',a:'Call us or use the service request form below. Let us know whether you have a tank or tankless water heater now, and what you would like to change.'}
];
---
<ServicePage title="Bay Area Tankless Water Heater Installation" description="Gas tankless water heater conversions and replacements by Water Heater Boys. See real installations, learn about the installation process, and request an estimate." label="Gas tankless water heaters" headline="Thinking tankless?" emphasis="Let’s plan it right." intro="Converting from a tank or replacing an existing tankless unit? Start with a clear plan for your home’s hot water needs and the installation behind them." infoHeading="A smaller system. A complete plan." infoSummary="Tankless installation starts with the conditions around the unit—not just the unit itself. We plan the setup, complete the necessary work, and test the finished system." steps={steps} note={{title:'Professional-grade equipment.',copy:'We install tankless water heaters designed for long-term residential use, with a focus on a clean installation that can be serviced.'}} faqs={faqs} jobs={jobs} workHeading="Our tankless work." alternatives={[{label:'Gas tank water heaters',url:'/services/gas-tank-water-heaters/'},{label:'heat pump water heaters',url:'/services/heat-pump-water-heaters/'}]}/>
