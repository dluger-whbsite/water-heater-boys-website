---
import Layout from '../../layouts/ServiceLayout.astro';
import {Image} from 'astro:assets';
import seismicPhoto from '../../assets/seismic-valve-original.jpg';
import moenFloPhoto from '../../assets/moen-flo.png';
const steps=[
 {title:'Assess your setup.',copy:'We review the existing gas or water line, the device being considered, and the installation location.'},
 {title:'Plan the installation.',copy:'For seismic gas valves, we handle sizing, placement, and installation. For smart water systems, we plan the device installation and connected setup.'},
 {title:'Finish the setup.',copy:'For Moen Flo installations, our team helps connect the device to Wi-Fi, set up the phone app, and calibrate the system.'}
];
const faqs=[
 {q:'Do you install both gas and water shut-off systems?',a:'Yes. Water Heater Boys installs seismic gas shut-off valves and smart water shut-off systems, including Moen Flo.'},
 {q:'Are these the same type of device?',a:'No. A seismic gas valve is installed on the gas supply, while a smart water shut-off system is installed on the water supply. We can discuss either service with you.'},
 {q:'Can you help set up the Moen Flo app?',a:'Yes. Our installation service includes Wi-Fi connection, phone app setup, and system calibration.'},
 {q:'How do I request an estimate?',a:'Call us or use the service request form below. Tell us whether you are interested in a seismic gas valve, a smart water shut-off system, or both, and include your property location.'}
];
---
<Layout title="Gas & Water Shut-Off Valve Installation in the Bay Area" description="Water Heater Boys installs seismic gas shut-off valves and Moen Flo smart water shut-off systems across the Bay Area. Discuss your property and request an estimate." workHref="/#work" estimateIntro="Tell us whether you need a seismic gas valve, a smart water shut-off system, or both. Prefer a conversation? Give us a call.">
<section class="hero service-hero"><div class="wrap"><p class="breadcrumb"><a href="/">Home</a> / <a href="/services/plumbing/">Plumbing</a> / Safety shut-off systems</p><div class="hero-grid"><div><p class="eyebrow">GAS &amp; WATER SHUT-OFF INSTALLATION</p><h1>Plan ahead.<br/><em>Add a layer<br/>of protection.</em></h1><p class="hero-description">Explore seismic gas shut-off valves and smart water shut-off systems with a team that can assess your property and handle the installation.</p><div class="actions"><a class="button" href="#estimate">Get an estimate ↗</a><a class="text-link" href="tel:6508442305">Call (650) 844-2305 ↗</a></div></div><aside class="service-summary"><p class="eyebrow">TWO DIFFERENT SYSTEMS</p><h2>Gas shut-off.<br/>Water shut-off.<br/>Help with both.</h2><ul><li>Seismic gas valve installation</li><li>Moen Flo smart water systems</li><li>Installation and setup support</li></ul><a class="text-link" href="#systems">Explore the options ↓</a></aside></div></div></section>
<section class="section wrap" id="systems"><div class="section-heading"><div><p class="eyebrow">THE RIGHT SYSTEM FOR THE JOB</p><h2>Understand your options.</h2></div></div><div class="service-intro"><article class="included-card"><p class="eyebrow">GAS SUPPLY</p><Image class="service-detail-photo" src={seismicPhoto} alt="Seismic gas shut-off valve installed beside an exterior gas meter" width={800} format="webp" loading="lazy"/><h3>Seismic gas shut-off valves</h3><p>Earthquake gas shut-off valves are designed to shut off the gas supply in response to seismic activity. We handle sizing, placement, and installation for your property.</p></article><article class="included-card"><p class="eyebrow">WATER SUPPLY</p><Image class="service-detail-photo" src={moenFloPhoto} alt="Moen Flo smart water shut-off device and mobile app" width={800} format="webp" loading="lazy"/><h3>Moen Flo smart water shut-off</h3><p>Water Heater Boys installs Moen Flo smart water shut-off systems, with support for the connected setup. Talk with our team about the device and installation requirements for your home.</p></article></div></section>
<section class="section included-section"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">FROM PLANNING TO SETUP</p><h2>What we take care of.</h2></div></div><div class="included-grid">{steps.map(s=><article class="included-card"><h3>{s.title}</h3><p>{s.copy}</p></article>)}</div><p class="brand-note"><strong>Looking for other plumbing help?</strong> Explore our <a class="text-link" href="/services/plumbing/">plumbing services ↗</a> for fixtures, drains, repiping, and more.</p></div></section>
<section class="section faq-section"><div class="wrap faq-grid"><div><p class="eyebrow">BEFORE WE GET STARTED</p><h2>A little clarity<br/>helps.</h2><p class="about-intro">Tell us what you are considering. We’ll help you understand the installation.</p><a class="text-link" href="tel:6508442305">(650) 844-2305 ↗</a></div><div>{faqs.map(f=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div></div></section>
</Layout>
