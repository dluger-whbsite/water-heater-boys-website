---
import ServicePage from '../../components/ServicePage.astro';
import {loadJobs} from '../../lib/jobs';
import {serviceJobs} from '../../lib/feeds.mjs';
const jobs=serviceJobs(await loadJobs(),'heat-pump');
const included=[
 {title:'Check the space.',copy:'We assess installation space, airflow, clearances, and noise considerations. Garages and utility spaces with adequate airflow are common locations, but the right fit depends on your home and the selected system.'},
 {title:'Plan power and drainage.',copy:'Each installation includes replacement water supply lines, required drain pans, and proper condensate routing. We evaluate electrical capacity and connections, and identify the electrical work required for the selected unit up front.'},
 {title:'Configure and test.',copy:'We install hybrid systems using manufacturer-recommended configurations. Once installed, the system is tested and configured for proper operation before the job is complete.'}
];
const faqs=[
 {q:'Can a heat pump water heater replace a gas tank?',a:'These systems are commonly installed as replacements for gas tank water heaters. We first assess the space, airflow, electrical capacity, and condensate drainage to determine what the installation will require.'},
 {q:'Where can a hybrid heat pump water heater go?',a:'Garages and utility spaces with adequate airflow are common locations. We evaluate the manufacturer’s space and clearance requirements, along with airflow and noise considerations, before recommending a setup.'},
 {q:'Will electrical work be needed?',a:'We evaluate your electrical capacity and the requirements of the selected unit before installation. Any required circuit or connection work should be part of the installation plan, not a surprise on the day.'},
 {q:'How do I find out whether it fits my home?',a:'Call us or send a service request below. Tell us about your current water heater and where it is installed, and our team can help you understand the next steps.'}
