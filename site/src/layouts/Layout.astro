---
const {title}=Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex,nofollow"/><title>{title} | Water Heater Boys</title><link rel="icon" href="/assets/logo.svg"/></head><body>
<div class="notice">OWNER REVIEW · Completed-jobs proof of concept</div>
<header><div class="wrap nav"><a href="/"><img src="/assets/logo.svg" width="145" height="90" alt="Water Heater Boys"/></a><nav><a href="/services/gas-tank-water-heaters/">Gas tank service</a><a href="/#recent-jobs">Recent jobs</a><a href="/workflow/">Test the workflow</a></nav><a class="button" href="tel:6508442305">(650) 844-2305</a></div></header>
<main><slot/></main><footer><div class="wrap">Water Heater Boys · Bay Area · CA License #1134458<br/><small>Design and workflow test. Customer service remains on the existing website.</small></div></footer>
</body></html>
<style is:global>
:root{--navy:#324158;--ink:#25364b;--yellow:#fbca46;--muted:#637081}*{box-sizing:border-box}body{margin:0;font:17px/1.65 Arial,sans-serif;color:var(--ink)}a{color:inherit}img{max-width:100%}h1,h2,h3{line-height:1.08;letter-spacing:-.04em}h1{font-size:clamp(3rem,6vw,5.8rem);margin:15px 0 25px}h2{font-size:clamp(2rem,4vw,3.5rem)}h3{font-size:1.5rem}p{color:var(--muted)}.wrap{width:min(1180px,calc(100% - 40px));margin:auto}.notice{text-align:center;background:#edf1f6;font-size:12px;padding:7px;letter-spacing:.08em}header,footer{background:var(--navy);color:white}.nav{display:flex;align-items:center;gap:35px;padding:15px 0}.nav img{object-fit:contain}.nav nav{display:flex;gap:24px;margin-left:auto;font-size:14px}.nav a{text-decoration:none}.button{display:inline-block;background:var(--yellow);color:var(--ink);padding:14px 22px;border-radius:5px;text-decoration:none;font-weight:bold}.hero{background:#f4f6f8;padding:65px 0}.hero-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:60px;align-items:center}.hero-image{width:100%;height:480px;object-fit:contain;background:#25364b;border-radius:6px}.eyebrow{text-transform:uppercase;letter-spacing:.1em;font-size:12px;font-weight:bold}.hero p{max-width:520px}.hero em{font-style:normal}.section{padding:65px 0}.section-heading{display:flex;justify-content:space-between;align-items:center;gap:20px}.jobs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.job{border:1px solid #dce1e7;border-radius:7px;overflow:hidden;background:white}.gallery{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;background:#e6e9ed}.gallery img{width:100%;flex:0 0 100%;height:330px;object-fit:contain;scroll-snap-align:start}.job-copy{padding:22px}.job-copy h3{margin-top:10px}.job-copy p{font-size:16px}.date{font-size:14px!important}.empty{grid-column:1/-1;background:#f4f6f8;padding:35px;border-radius:6px}.band{background:#f4f6f8}.steps{max-width:820px}.steps li{padding:12px 0}.callout{padding:22px;border-left:4px solid var(--yellow);background:#f4f6f8}.links{display:flex;gap:20px;flex-wrap:wrap}footer{padding:40px 0}a:focus-visible{outline:3px solid #b37500;outline-offset:5px}@media(max-width:760px){.nav{flex-wrap:wrap;gap:15px}.nav nav{order:3;width:100%;justify-content:space-between;margin:0;gap:12px}.nav>.button{margin-left:auto;padding:12px}.hero-grid{grid-template-columns:1fr;gap:25px}.hero{padding:35px 0}.hero-image{height:340px}.jobs{grid-template-columns:1fr}.section{padding:40px 0}.section-heading{display:block}.gallery img{height:380px}}
</style>
